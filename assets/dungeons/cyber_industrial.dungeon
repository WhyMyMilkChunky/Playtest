# S3D procedural dungeon theme
# Rooms, halls, props, materials, and lighting can be extended without changing C++.
theme cyber_industrial Cyber Industrial Complex
materials floor wall ceiling panel cyber_door_security cyber_door_security emissive
architecture industrial
detail_materials cyber_catwalk_floor cyber_stair_floor cyber_structure
environment 0.018 0.026 0.045 0.045 0.070 0.100 0.220 0.820 1.000 1.000 0.240 0.560

# room id role min_width min_depth max_width max_depth height weight cover main side dead_end vertical tags
room entry_checkpoint entry 20 20 28 28 7.0 1.0 none 1 0 0 0 security,main
room combat_standard combat 24 24 34 34 8.0 4.0 alternating 1 1 0 0 combat
room combat_crossfire combat 26 22 38 32 9.0 2.8 heavy 1 1 0 0 combat,crossfire
room combat_perimeter combat 28 24 40 36 10.0 2.2 perimeter 1 1 0 0 combat,flanking
room combat_arena arena 32 32 46 46 18.0 1.8 heavy 1 1 0 1 combat,large,vertical
room arena_overlook arena 34 30 46 42 18.0 1.4 alternating 1 1 0 1 combat,large,vertical,overlook
room machine_chamber chamber 28 26 42 40 18.0 1.3 machine 1 1 0 1 large,utility
room assembly_chamber chamber 30 28 44 40 18.0 1.2 structural 1 1 0 1 large,vertical,assembly
room routing_room puzzle 22 22 30 30 8.0 1.2 puzzle 0 1 1 0 puzzle,power
room routing_relay puzzle 24 20 34 28 9.0 1.0 puzzle 0 1 1 0 puzzle,research
room secure_storage loot 20 20 28 28 7.0 1.4 perimeter 0 1 1 0 loot,storage
room storage_loading loot 24 20 34 30 8.0 1.1 perimeter 0 1 1 0 loot,storage,loading
room service_transition transition 20 20 28 30 9.0 1.5 sparse 1 1 0 0 service
room transit_junction transition 24 22 34 34 9.0 1.3 sparse 1 1 0 0 transit,junction
room hidden_cache secret 16 16 22 22 7.0 0.8 perimeter 0 1 1 0 secret,loot
room boss_reactor boss 38 36 50 48 14.0 1.0 structural 1 0 1 1 boss,large
room utility_power utility 22 22 30 30 8.0 1.5 machine 0 1 0 0 utility,power
room utility_maintenance utility 20 18 30 26 8.0 1.4 sparse 0 1 0 0 utility,maintenance

# room_style room_id silhouette facility_zone vertical_profile lighting_profile min_entrances max_entrances entrance_safe_depth
room_style entry_checkpoint checkpoint security flat security 1 2 5.0
room_style combat_standard stepped production flat cool 2 4 4.5
room_style combat_crossfire split production flat warning 2 4 5.0
room_style combat_perimeter rectangular transit sunken cool 2 4 5.0
room_style combat_arena atrium transit multi warning 2 4 5.0
room_style arena_overlook stepped production multi warning 2 4 5.5
room_style machine_chamber split power catwalk cool 2 4 4.5
room_style assembly_chamber atrium power catwalk cool 2 4 5.0
room_style routing_room split power raised low_power 1 3 4.5
room_style routing_relay checkpoint research raised low_power 1 3 4.5
room_style secure_storage rectangular storage flat service 1 2 4.0
room_style storage_loading stepped storage flat service 1 2 4.5
room_style service_transition stepped transit raised service 1 4 4.0
room_style transit_junction checkpoint transit flat security 2 4 5.0
room_style hidden_cache rectangular maintenance flat low_power 1 1 3.5
room_style boss_reactor reactor command raised reactor 1 3 6.0
room_style utility_power split maintenance raised warning 1 3 4.5
room_style utility_maintenance rectangular maintenance flat low_power 1 3 4.0


