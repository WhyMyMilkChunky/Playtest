# S3D dungeon theme variant
inherit assets/dungeons/cyber_industrial.dungeon
theme cryo_research Cryogenic Research Sector
materials cryo_floor cryo_wall cryo_ceiling cryo_panel cryo_door_security cryo_door_security emissive
architecture research
detail_materials cryo_catwalk_floor cryo_stair_floor cryo_structure
environment 0.008 0.018 0.035 0.030 0.070 0.105 0.280 0.880 1.000 0.540 0.260 1.000

# Clean insulated prop skins retain the base geometry and placement rules.
prop_material cover_crate cryo_crate
prop_material low_barrier cryo_crate
prop_material security_locker locker
prop_material floor_console cryo_machinery
prop_material pipe_bank cryo_machinery
prop_material wall_duct pipes
prop_material machine_block cryo_machinery
prop_material support_column cryo_machinery

# Colder research lighting with warning contrast in critical rooms.
room_layout combat_standard 24 22 32 30 8.0 4.4 alternating
room_layout combat_crossfire 24 22 34 30 9.0 3.0 alternating
room_layout combat_perimeter 26 24 36 32 9.0 2.5 sparse
room_layout combat_arena 30 30 42 40 16.0 1.6 heavy
room_layout arena_overlook 32 28 42 38 17.0 1.5 alternating
room_layout machine_chamber 26 24 38 36 16.0 1.4 machine
room_layout assembly_chamber 28 26 40 36 17.0 1.4 structural
room_layout routing_room 22 20 30 28 9.0 1.5 puzzle
room_style combat_standard rectangular security flat cool 2 4 4.5
room_style combat_crossfire checkpoint security flat cool 2 4 5.0
room_style combat_perimeter split research raised cool 2 4 5.0
room_style combat_arena atrium research multi cool 2 4 5.0
room_style arena_overlook stepped research multi warning 2 4 5.5
room_style machine_chamber split research catwalk cool 2 4 4.5
room_style assembly_chamber atrium research catwalk cool 2 4 5.0
room_style routing_room checkpoint research raised low_power 1 3 4.5
room_style routing_relay split research raised low_power 1 3 4.5
room_style storage_loading rectangular storage flat service 1 2 4.5
room_style service_transition checkpoint transit flat service 1 4 4.0
room_style transit_junction checkpoint transit flat security 2 4 5.0
room_style utility_maintenance rectangular maintenance flat low_power 1 3 4.0
room_style boss_reactor reactor command raised warning 1 3 6.0

# Cryo circulation favors controlled segmented and straight laboratory routes.
hall_layout industrial_l straight 7.0 5.5 3.2 1 1
hall_layout security_boulevard segmented 9.0 6.0 1.3 1 1
hall_layout service_corridor service 5.5 5.0 2.1 0 0
hall_layout segmented_transfer straight 7.5 5.5 1.8 1 1
hall_layout industrial_passage wide 10.0 6.5 0.8 1 1
# Room-purpose palettes: floor, wall, ceiling, service panel.
room_materials entry_checkpoint cryo_security_floor cryo_security_wall cryo_security_ceiling cryo_panel
room_materials combat_standard cryo_production_floor cryo_production_wall cryo_production_ceiling cryo_panel
room_materials combat_crossfire cryo_security_floor cryo_security_wall cryo_security_ceiling cryo_panel
room_materials combat_perimeter cryo_transit_floor cryo_transit_wall cryo_transit_ceiling cryo_panel
room_materials combat_arena cryo_production_floor cryo_production_wall cryo_production_ceiling cryo_panel
room_materials arena_overlook cryo_security_floor cryo_security_wall cryo_security_ceiling cryo_panel
room_materials machine_chamber cryo_power_floor cryo_power_wall cryo_power_ceiling cryo_panel
room_materials assembly_chamber cryo_production_floor cryo_production_wall cryo_service_ceiling cryo_panel
room_materials routing_room cryo_power_floor cryo_power_wall cryo_power_ceiling cryo_panel
room_materials routing_relay cryo_security_floor cryo_production_wall cryo_security_ceiling cryo_panel
room_materials secure_storage cryo_storage_floor cryo_storage_wall cryo_storage_ceiling cryo_panel
room_materials storage_loading cryo_storage_floor cryo_service_wall cryo_storage_ceiling cryo_panel
room_materials service_transition cryo_transit_floor cryo_transit_wall cryo_transit_ceiling cryo_panel
room_materials transit_junction cryo_transit_floor cryo_security_wall cryo_transit_ceiling cryo_panel
room_materials hidden_cache cryo_service_floor cryo_service_wall cryo_service_ceiling cryo_panel
room_materials boss_reactor cryo_power_floor cryo_security_wall cryo_power_ceiling cryo_panel
room_materials utility_power cryo_power_floor cryo_power_wall cryo_power_ceiling cryo_panel
room_materials utility_maintenance cryo_service_floor cryo_service_wall cryo_service_ceiling cryo_panel

# Corridors keep a coherent palette for their entire route, including elbows.
hall_materials industrial_l cryo_transit_floor cryo_production_wall cryo_transit_ceiling cryo_structure
hall_materials security_boulevard cryo_security_floor cryo_security_wall cryo_security_ceiling cryo_structure
hall_materials service_corridor cryo_service_floor cryo_service_wall cryo_service_ceiling cryo_structure
hall_materials segmented_transfer cryo_transit_floor cryo_transit_wall cryo_transit_ceiling cryo_structure
hall_materials industrial_passage cryo_production_floor cryo_production_wall cryo_production_ceiling cryo_structure
hall_materials freight_lift cryo_transit_floor cryo_transit_wall cryo_transit_ceiling cryo_structure

# Research variants: controlled galleries, raised workstations, and isolation bays.
room_layout service_workshop 22 18 30 24 8.0 1.5 sparse
room_layout process_gallery 24 20 34 28 9.0 1.8 alternating
room_layout freight_staging 22 20 32 28 8.0 1.2 perimeter
room_layout containment_annex 24 22 34 30 10.0 1.6 puzzle
room_style service_workshop rectangular maintenance flat service 1 3 4.5
room_style process_gallery checkpoint research flat cool 2 4 5.0
room_style freight_staging rectangular storage flat service 1 2 4.5
room_style containment_annex split research raised cool 1 3 4.5
hall_style industrial_l sparse 0 7.0
hall_style security_boulevard alternating 1 6.0
room_materials service_workshop cryo_service_floor cryo_service_wall cryo_service_ceiling cryo_panel
room_materials process_gallery cryo_production_floor cryo_production_wall cryo_transit_ceiling cryo_panel
room_materials freight_staging cryo_storage_floor cryo_storage_wall cryo_service_ceiling cryo_panel
room_materials containment_annex cryo_security_floor cryo_production_wall cryo_power_ceiling cryo_panel
