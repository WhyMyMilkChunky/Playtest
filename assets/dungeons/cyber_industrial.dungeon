# hall id shape width height weight combat_capable allows_elevation
hall industrial_l l_shaped 7.0 5.5 3.0 1 1
hall security_boulevard wide 10.0 6.5 1.0 1 1
hall service_corridor service 5.5 5.0 1.8 0 0
hall segmented_transfer segmented 8.0 6.0 1.4 1 1
hall industrial_passage industrial 12.0 7.5 0.8 1 1
hall freight_lift lift 7.0 7.0 1.0 0 1

# hall_style hall_id cover_profile junction_capable support_spacing
hall_style industrial_l sparse 0 8.0
hall_style security_boulevard alternating 1 7.0
hall_style service_corridor none 0 5.0
hall_style segmented_transfer sparse 1 7.0
hall_style industrial_passage alternating 1 8.0
hall_style freight_lift none 0 6.0

# Believable facility circulation rules used when assigning destinations.
adjacency security transit 2.5
adjacency transit production 2.2
adjacency production maintenance 1.8
adjacency production storage 2.0
adjacency maintenance power 2.4
adjacency power research 1.8
adjacency research command 2.2

# prop id category material min_size_xyz max_size_xyz weight cover_value solid
prop cover_crate cover crate 1.5 1.1 1.5 2.4 1.5 2.4 3.0 0.8 1
prop low_barrier cover crate 2.4 0.8 0.8 3.6 1.2 1.2 1.4 0.6 1
