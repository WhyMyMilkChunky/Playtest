# Reusable two-plane muzzle flash. Local -Z points out of the barrel.
o muzzle_flash_cross

# Camera-facing plane, slightly forward of the muzzle origin.
v -0.5 -0.5 -0.12
v  0.5 -0.5 -0.12
v  0.5  0.5 -0.12
v -0.5  0.5 -0.12

# Longitudinal plane gives the flash depth from oblique views.
v -0.5 0.0  0.24
v  0.5 0.0  0.24
v  0.5 0.0 -0.76
v -0.5 0.0 -0.76

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vn 0.0 0.0 1.0
vn 0.0 1.0 0.0

f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
f 5/1/2 6/2/2 7/3/2
f 5/1/2 7/3/2 8/4/2
