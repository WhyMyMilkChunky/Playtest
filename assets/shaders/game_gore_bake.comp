#version 460 core
#include "include/s3d_backend.glsl"

layout(local_size_x = 64) in;
struct Source
{
	vec4 normalUv, surface;
	uvec4 address, bones;
	vec4 weights;
	uvec4 link;
};
struct Influence { vec4 positionWeight; uvec4 bone; };
S3D_RESOURCE(0, 0) layout(std430) readonly buffer Sources { Source sources[]; };
S3D_RESOURCE(0, 1) layout(std430) readonly buffer Influences { Influence influences[]; };
S3D_RESOURCE(0, 2) layout(std140) uniform Pose { mat4 bones[20]; uvec4 counts; };
S3D_RESOURCE(0, 3) layout(std430) writeonly buffer Output { uint words[]; };

void main()
{
	uint index = gl_GlobalInvocationID.x;
	if (index >= counts.x) return;
	if (index == 0u) { words[0] = 0u; words[1] = 0u; words[2] = 0u; words[3] = 0u; }
	Source source = sources[index];
	vec3 p = vec3(0.0), n = vec3(0.0);
	for (uint k = 0u; k < source.address.y; ++k)
	{
		Influence influence = influences[source.address.x + k];
		p += (bones[min(influence.bone.x, 19u)] * influence.positionWeight).xyz;
	}
	for (int k = 0; k < 4; ++k)
		n += mat3(bones[min(source.bones[k], 19u)]) * source.normalUv.xyz * source.weights[k];
	n *= inversesqrt(max(dot(n, n), 1e-12));
	uint first = 4u + index * 13u;
	// scalar words match the 52-byte CPU layout; std430 vec3 members would insert padding.
	words[first] = floatBitsToUint(p.x);
	words[first + 1u] = floatBitsToUint(p.y);
	words[first + 2u] = floatBitsToUint(p.z);
	words[first + 3u] = floatBitsToUint(n.x);
	words[first + 4u] = floatBitsToUint(n.y);
	words[first + 5u] = floatBitsToUint(n.z);
	words[first + 6u] = floatBitsToUint(source.normalUv.w);
	words[first + 7u] = floatBitsToUint(source.surface.x);
	words[first + 8u] = source.address.z;
	words[first + 9u] = source.address.w;
	words[first + 10u] = source.link.x;
	words[first + 11u] = floatBitsToUint(source.surface.y);
	words[first + 12u] = floatBitsToUint(source.surface.z);
}
